# Kopjo si .env dhe plotëso vlerat reale. .env s'duhet commit-uar kurrë.

# Gjenero një të re: python -c "from django.core.management.utils import get_random_secret_key; print(get_random_secret_key())"
SECRET_KEY=

# True vetëm lokalisht/zhvillim. Gjithmonë False në prodhim (PythonAnywhere/Render).
DEBUG=True

# Bosh ose "sqlite:///db.sqlite3" = SQLite lokal.
# Për Postgres (Neon/Render): postgres://user:password@host:port/dbname
DATABASE_URL=sqlite:///db.sqlite3

# Path absolut në prodhim (p.sh. Docker/Render), relativ (nga BASE_DIR) lokalisht.
FIREBASE_CREDENTIALS_PATH=firebase-credentials.json

# Cloudinary (media storage — i detyrueshëm në prodhim, shih docs/04)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Opsionale — hosts të lejuar, të ndarë me presje
# ALLOWED_HOSTS=localhost,127.0.0.1,thesarislam.pythonanywhere.com
